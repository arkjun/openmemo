{
  "name": "openmemo",
  "version": "0.1.0",
  "description": "OpenTUI-based memo app inspired by mattn/memo",
  "type": "module",
  "bin": {
    "openmemo": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arkjun/openmemo.git"
  },
  "author": "arkjun",
  "license": "MIT",
  "keywords": [
    "memo",
    "cli",
    "terminal",
    "tui",
    "note",
    "markdown"
  ],
  "homepage": "https://github.com/arkjun/openmemo#readme",
  "bugs": {
    "url": "https://github.com/arkjun/openmemo/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "bun dist/cli.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm run test:run"
  },
  "dependencies": {
    "@opentui/core": "^0.1.75"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@vitest/coverage-v8": "^4.0.18",
    "typescript": "^5.4.5",
    "vitest": "^4.0.18"
  }
}
